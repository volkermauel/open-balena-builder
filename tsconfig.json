{
    "compilerOptions": {
        "module": "CommonJS",
        "esModuleInterop": true,
        "target": "ES2022",
        "lib": ["ES2022"],
        "noImplicitAny": true,
        "noUnusedLocals": false,
        "noUnusedParameters": true,
        "preserveConstEnums": true,
        "removeComments": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "moduleResolution": "node",
        "baseUrl": ".",
        "declaration": true,
        "rootDir": "src",
        "outDir": "./dist"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts"]
}